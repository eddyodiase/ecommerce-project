
on:
  push:
    branches:
      - main

name: Deploy to Production

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v2

      - name: Set up Node.js
        uses: actions/setup-node@v2
        with:
          node-version: '14'

      - name: Install dependencies
        run: npm install

      - name: Build project
        run: npm run build
      - name: Run tests
        run: npm run test

      - name: Deploy to Production Server
        env:
        SERVER: ${{ secrets.GIT_CPANEL_REACT_SERVER }}
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SERVER_USER: ${{ secrets.SERVER_USER }}
          SERVER_HOST: ${{ secrets.SERVER_HOST }}
          PROTOCOL: ${{ secrets.GIT_CPANEL_REACT_PROTOCOL }}
          LOCAL_BUILD_DIR: ${{ secrets.GIT_CPANEL_REACT_LOCAL_BUILD_DIR }}
        run: |
          echo "$SSH_PRIVATE_KEY" > private_key.pem
          chmod 600 private_key.pem
          scp -i private_key.pem -r ./build/* $SERVER_USER@$SERVER_HOST:/var/www/html/
          rm private_key.pem